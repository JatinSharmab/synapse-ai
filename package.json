{
  "name": "synapse-ai",
  "version": "0.15.0",
  "private": true,
  "description": "Synapse Enterprise AI Intelligence OS monorepo",
  "workspaces": [
    "frontend",
    "gateway"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @synapse/frontend",
    "dev:gateway": "npm run dev --workspace @synapse/gateway",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
