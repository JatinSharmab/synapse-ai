{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "declaration": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": "..",
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "src/api/schemas.ts",
    "src/api/readiness.ts",
    "src/components/evidence/video-utils.ts",
    "src/genui",
    "src/streaming/client.ts",
    "src/workspace/stream-state.ts",
    "tests",
    "../shared/genui.ts",
    "../shared/streaming.ts"
  ]
}
